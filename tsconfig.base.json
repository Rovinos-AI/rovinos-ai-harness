{
  "compilerOptions": {
    "target": "ES2023",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "noImplicitOverride": true,
    "verbatimModuleSyntax": true,
    "paths": {
      "eventsource": ["./node_modules/eventsource/dist/index.d.ts"],
      "eventsource-parser": ["./node_modules/eventsource-parser/dist/index.d.ts"]
    },
    "declaration": true,
    "composite": true,
    "outDir": "dist"
  }
}
