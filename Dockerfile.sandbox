# SPDX-License-Identifier: Apache-2.0
FROM ghcr.io/jdx/mise:2026.10.4-debian@sha256:2fb7fa9a4120333531a8a70296d4ea152ffd3e7658dcf29ac75774a7d78dec24 AS manifests

WORKDIR /src
COPY packages packages
COPY tools tools
RUN mkdir -p /manifests \
    && find packages tools -name package.json -not -path "*/node_modules/*" -exec cp --parents {} /manifests/ \;

FROM ghcr.io/jdx/mise:2026.10.4-debian@sha256:2fb7fa9a4120333531a8a70296d4ea152ffd3e7658dcf29ac75774a7d78dec24 AS build

WORKDIR /app
RUN apt-get update \
    && apt-get install -y --no-install-recommends build-essential=12.12 python3=3.13.5-1 \
    && rm -rf /var/lib/apt/lists/*
COPY mise.toml ./
RUN mise install node npm:corepack
ENV MISE_AUTO_INSTALL=false
RUN mise exec -- corepack enable
COPY package.json yarn.lock .yarnrc.yml ./
COPY --from=manifests /manifests/ ./
RUN mise exec -- yarn install --immutable
COPY . .
RUN mise exec -- yarn build \
    && mise exec -- yarn workspaces focus @harness/sandbox --production

FROM node:26-slim@sha256:0d1e33586362bb9e608c4e751e7a9e7edb55c9ac11461ed5666af696cc461dd4 AS runtime

WORKDIR /app
RUN groupadd --gid 10003 sandbox-shared \
    && useradd --uid 10002 --gid sandbox-shared --no-create-home --shell /usr/sbin/nologin sandbox \
    && useradd --uid 10003 --gid sandbox-shared --no-create-home --shell /usr/sbin/nologin sandbox-exec \
    && mkdir -p /workspaces \
    && chown 10002:10003 /workspaces \
    && chmod 0750 /workspaces \
    && chown 10002:10003 /app \
    && rm -rf /usr/bin/apt /usr/bin/apt-get /usr/bin/apt-cache /usr/bin/apt-cdrom /usr/bin/apt-config \
      /usr/bin/dpkg* /usr/sbin/dpkg* /usr/lib/apt /usr/lib/dpkg \
      /var/lib/apt /var/lib/dpkg /var/cache/apt \
      /usr/share/doc/apt /usr/share/doc/dpkg /usr/share/man/man1/apt* \
      /usr/share/man/man8/apt* /usr/share/man/man1/dpkg* /usr/share/man/man8/dpkg* \
      /usr/local/bin/npm /usr/local/bin/npx /usr/local/bin/corepack \
      /usr/local/lib/node_modules/npm /usr/local/lib/node_modules/corepack \
    && find / -xdev -perm /6000 -type f -exec chmod a-s {} + \
    && command -v prlimit \
    && command -v setpriv \
    && command -v node \
    && ! command -v apt-get \
    && ! command -v dpkg \
    && ! command -v npm \
    && ! command -v docker
COPY --from=build /app/node_modules/ ./node_modules/
COPY --from=build /app/packages/sandbox/package.json ./packages/sandbox/package.json
COPY --from=build /app/packages/sandbox/dist/ ./packages/sandbox/dist/
COPY --from=build /app/packages/context/package.json ./packages/context/package.json
COPY --from=build /app/packages/context/dist/ ./packages/context/dist/
COPY --from=build /app/packages/schemas/package.json ./packages/schemas/package.json
COPY --from=build /app/packages/schemas/dist/ ./packages/schemas/dist/
COPY --from=build /app/packages/crypto/package.json ./packages/crypto/package.json
COPY --from=build /app/packages/crypto/dist/ ./packages/crypto/dist/
USER 10002:10003
ARG REVISION=unknown
LABEL org.opencontainers.image.source="https://github.com/Rovinos-AI/rovinos-ai-harness" \
      org.opencontainers.image.licenses="Apache-2.0" \
      org.opencontainers.image.revision="${REVISION}"
ENTRYPOINT ["node", "packages/sandbox/dist/runner/src/server.js"]
