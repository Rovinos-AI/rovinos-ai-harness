{
  "version": "0.2",
  "language": "en",
  "files": ["**/*.md", "packages/*/src/**/*"],
  "ignorePaths": [
    "**/node_modules/**",
    ".tmp/**",
    "**/dist/**",
    "**/coverage/**",
    "**/*.generated.*"
  ],
  "words": [
    "WSENC",
    "AQID",
    "checkpointed",
    "describedby",
    "hardlink",
    "HMGET",
    "hostcontextchanged",
    "HSET",
    "ustar",
    "decryptable",
    "errortype",
    "hashtextextended",
    "ILIKE",
    "labelledby",
    "MSAL",
    "noopener",
    "noreferrer",
    "nodev",
    "nosuid",
    "onhostcontextchanged",
    "onopenlink",
    "onrequestdisplaymode",
    "onteardown",
    "onupdatemodelcontext",
    "plpgsql",
    "PEXPIRE",
    "rediss",
    "sizechange",
    "tldts",
    "toolinput",
    "toolresult",
    "tooluse",
    "transactionally",
    "unconfigured",
    "unlisten",
    "vllm"
  ],
  "dictionaryDefinitions": [
    {
      "name": "project-words",
      "path": "./docs/engineering/project-words.txt",
      "addWords": true
    }
  ],
  "dictionaries": ["project-words"],
  "ignoreRegExpList": ["GHSA(-[23456789cfghjmpqrvwx]{4}){3}"]
}
