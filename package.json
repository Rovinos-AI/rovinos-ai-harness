{
  "name": "rovinos-ai-harness",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "license": "Apache-2.0",
  "workspaces": [
    "packages/*",
    "tools/*"
  ],
  "engines": {
    "node": ">=26.12.0"
  },
  "packageManager": "yarn@4.18.1+sha512.b2e1e7524f654f2749d32b4ebcb4622473cb5bcbc485df2007e12a154e50162a4d795526768bc5f5b8f81717bfd79deb2472813d86fb5ae2eb551fa9c872b08f",
  "dependenciesMeta": {
    "better-sqlite3": {
      "built": true
    },
    "esbuild": {
      "built": true
    }
  },
  "resolutions": {
    "node-releases": "2.0.57",
    "zod": "4.6.7"
  },
  "scripts": {
    "build": "yarn workspaces foreach --all --topological-dev --parallel run build",
    "compose:sandbox": "corepack yarn build:schemas && corepack yarn workspace @rovinos/config build && node --experimental-strip-types --disable-warning=ExperimentalWarning scripts/compose/sandbox.ts",
    "quickstart": "yarn build:schemas && node --experimental-strip-types --disable-warning=ExperimentalWarning scripts/quickstart.ts",
    "quickstart:down": "yarn build:schemas && node --experimental-strip-types --disable-warning=ExperimentalWarning scripts/quickstart.ts --down",
    "start": "yarn build && yarn workspace @rovinos/cli start",
    "clean": "node scripts/clean.mjs",
    "deps:check": "yarn constraints && yarn dedupe --check",
    "build:schemas": "yarn workspace @rovinos/schemas build",
    "build:host": "yarn workspaces foreach --recursive --topological --from @rovinos/host run build",
    "docs:catalog": "yarn build && node --experimental-strip-types --disable-warning=ExperimentalWarning scripts/gen-attribute-catalog.ts",
    "gen:collector": "yarn build && node --experimental-strip-types --disable-warning=ExperimentalWarning scripts/gen-collector-allowlist.ts",
    "gen:pii-corpus": "node --experimental-strip-types --disable-warning=ExperimentalWarning scripts/gen-pii-corpus.ts",
    "check:pii-corpus": "node --experimental-strip-types --disable-warning=ExperimentalWarning scripts/gen-pii-corpus.ts --check",
    "pii:report": "node --experimental-strip-types --disable-warning=ExperimentalWarning scripts/pii-report.ts",
    "lint": "yarn build:schemas && yarn lint:md && yarn lint:yaml && yarn lint:sh && yarn lint:docker && yarn lint:editorconfig && yarn lint:spell && yarn lint:ts && prettier --check . && yarn deps:check",
    "lint:fix": "yarn build:schemas && markdownlint-cli2 --fix \"**/*.md\" \".github/**/*.md\" && node --experimental-strip-types --disable-warning=ExperimentalWarning scripts/lint-ts.ts --fix && prettier --write .",
    "lint:ts": "node --experimental-strip-types --disable-warning=ExperimentalWarning scripts/lint-ts.ts",
    "lint:md": "markdownlint-cli2 \"**/*.md\" \".github/**/*.md\"",
    "lint:claims": "node --experimental-strip-types --disable-warning=ExperimentalWarning scripts/docs/lint-claims.ts",
    "lint:yaml": "eslint \"**/*.{yaml,yml}\" --max-warnings 0",
    "lint:sh": "node --experimental-strip-types --disable-warning=ExperimentalWarning scripts/lint-extended.ts shell",
    "lint:docker": "node --experimental-strip-types --disable-warning=ExperimentalWarning scripts/lint-extended.ts docker",
    "lint:editorconfig": "node --experimental-strip-types --disable-warning=ExperimentalWarning scripts/lint-extended.ts editorconfig",
    "lint:spell": "cspell --config cspell.json --no-progress \"**/*.md\" \"packages/*/src/**/*\"",
    "lint:telemetry": "vitest run --project unit packages/telemetry/src/registry.lint.test.ts test/telemetry-catalog.lint.test.ts",
    "check:publish-surface": "node --experimental-strip-types --disable-warning=ExperimentalWarning scripts/release/check-publish-surface.ts",
    "typecheck": "tsc -p packages/schemas/tsconfig.json && tsc -p packages/schemas/tsconfig.test.json && tsc -p packages/app-telemetry/tsconfig.json && tsc -p packages/app-telemetry/tsconfig.test.json && yarn workspace @rovinos/approval-app typecheck && tsc -p packages/crypto/tsconfig.json && tsc -p packages/crypto/tsconfig.test.json && tsc -p packages/config/tsconfig.json && tsc -p packages/telemetry/tsconfig.json && tsc -p packages/context/tsconfig.json && tsc -p packages/mcp/tsconfig.json && tsc -p packages/store/tsconfig.json && tsc -p packages/store/tsconfig.test.json && tsc -p packages/store-sqlite/tsconfig.json && tsc -p packages/store-sqlite/tsconfig.test.json && tsc -p packages/store-postgres/tsconfig.json && tsc -p packages/store-postgres/tsconfig.test.json && tsc -p packages/replay/tsconfig.json && tsc -p packages/core/tsconfig.json && tsc -p packages/pii/tsconfig.json && tsc -p packages/vault/tsconfig.json && tsc -p packages/models/tsconfig.json && tsc -p packages/policy/tsconfig.json && tsc -p packages/policy/tsconfig.test.json && tsc -p packages/host/tsconfig.json && tsc -p packages/host/tsconfig.test.json && tsc -p packages/sandbox/tsconfig.json && tsc -p packages/sandbox/tsconfig.test.json && tsc -p packages/control-plane/tsconfig.json && tsc -p packages/eval/tsconfig.json && tsc -p packages/eval/tsconfig.test.json && tsc -p packages/cli/tsconfig.json && tsc -p packages/sdk/tsconfig.json && tsc -p examples/sdk/tsconfig.json && tsc -p examples/tsconfig.json && tsc -p examples/evals/tsconfig.json && tsc -p scripts/tsconfig.json && tsc -p test/tsconfig.json && tsc -p tools/eslint-plugin-harness/tsconfig.json --noEmit",
    "test:unit": "yarn build:schemas && NODE_OPTIONS=--no-experimental-webstorage vitest run --project unit",
    "test:integration": "vitest run --project integration --project integration-compose --passWithNoTests",
    "test:canary": "vitest run --project canary --passWithNoTests",
    "test:replay": "vitest run --project replay --passWithNoTests",
    "test:live:akv": "vitest run --project live packages/vault/src/akv.live.test.ts",
    "test:live:vertex": "vitest run --project live packages/models/src/providers/vertex.live.test.ts",
    "gen:agents": "yarn build:schemas && node scripts/gen-agents-index.mjs",
    "check:agents": "yarn build:schemas && node scripts/gen-agents-index.mjs --check && node --test scripts/gen-agents-index.test.mjs",
    "check:spdx": "node --experimental-strip-types --disable-warning=ExperimentalWarning scripts/check-spdx.ts",
    "check:dco": "yarn build:schemas && node --experimental-strip-types --disable-warning=ExperimentalWarning scripts/check-dco.ts",
    "check:licenses": "yarn build:schemas && node --experimental-strip-types --disable-warning=ExperimentalWarning scripts/check-licenses.ts",
    "verify:release": "node --experimental-strip-types --disable-warning=ExperimentalWarning scripts/release/verify-release.ts",
    "check:threat-cases": "yarn build:schemas && node --experimental-strip-types --disable-warning=ExperimentalWarning scripts/check-threat-cases.ts"
  },
  "devDependencies": {
    "@changesets/cli": "3.0.3",
    "@eslint-community/eslint-plugin-eslint-comments": "4.8.1",
    "@modelcontextprotocol/client": "2.3.1",
    "@modelcontextprotocol/inspector": "2.12.0",
    "@modelcontextprotocol/node": "2.1.1",
    "@modelcontextprotocol/server": "2.3.1",
    "@opentelemetry/api": "1.9.1",
    "@opentelemetry/api-logs": "0.223.0",
    "@opentelemetry/core": "2.12.0",
    "@rovinos/cli": "workspace:^",
    "@rovinos/config": "workspace:^",
    "@rovinos/context": "workspace:^",
    "@rovinos/control-plane": "workspace:^",
    "@rovinos/core": "workspace:^",
    "@rovinos/eslint-plugin-harness": "workspace:^",
    "@rovinos/eval": "workspace:^",
    "@rovinos/host": "workspace:^",
    "@rovinos/mcp": "workspace:^",
    "@rovinos/models": "workspace:^",
    "@rovinos/pii": "workspace:^",
    "@rovinos/policy": "workspace:^",
    "@rovinos/replay": "workspace:^",
    "@rovinos/sandbox": "workspace:^",
    "@rovinos/schemas": "workspace:^",
    "@rovinos/sdk": "workspace:^",
    "@rovinos/store": "workspace:^",
    "@rovinos/store-postgres": "workspace:^",
    "@rovinos/store-sqlite": "workspace:^",
    "@rovinos/telemetry": "workspace:^",
    "@rovinos/vault": "workspace:^",
    "@types/node": "26.6.5",
    "@types/spdx-expression-parse": "4.0.0",
    "@vitest/coverage-v8": "4.1.12",
    "@vitest/eslint-plugin": "1.6.28",
    "better-sqlite3": "13.0.3",
    "commander": "15.0.0",
    "cspell": "10.4.0",
    "eslint": "9.39.2",
    "eslint-config-prettier": "10.1.8",
    "eslint-import-resolver-node": "0.4.0",
    "eslint-plugin-import-x": "4.17.1",
    "eslint-plugin-jsdoc": "65.4.2",
    "eslint-plugin-n": "18.5.0",
    "eslint-plugin-promise": "7.3.0",
    "eslint-plugin-regexp": "3.3.1",
    "eslint-plugin-unicorn": "78.0.0",
    "eslint-plugin-yml": "3.9.0",
    "markdownlint-cli2": "0.24.0",
    "playwright": "1.64.1",
    "prettier": "3.9.10",
    "spdx-expression-parse": "5.0.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.0",
    "vitest": "3.2.6",
    "yaml": "2.9.1",
    "zod": "4.6.7"
  }
}
