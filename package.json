{
  "name": "rovinos-ai-harness",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "packageManager": "pnpm@9.15.9",
  "pnpm": {
    "overrides": {
      "@types/node": "$@types/node"
    }
  },
  "scripts": {
    "build": "tsc -b",
    "lint": "eslint . --max-warnings 0 && prettier --check .",
    "lint:fix": "eslint . --fix --max-warnings 0 && prettier --write .",
    "typecheck": "tsc -b && tsc -p packages/schemas/tsconfig.test.json && tsc -p packages/cli/tsconfig.json && tsc -p scripts/ci/tsconfig.json && tsc -p tools/eslint-plugin-harness/tsconfig.json --noEmit",
    "test:unit": "vitest run --project unit",
    "test:integration": "vitest run --project integration --passWithNoTests",
    "test:canary": "vitest run --project canary --passWithNoTests",
    "test:replay": "vitest run --project replay --passWithNoTests",
    "gen:agents": "node scripts/gen-agents-index.mjs",
    "check:agents": "node scripts/gen-agents-index.mjs --check && node --test scripts/gen-agents-index.test.mjs"
  },
  "devDependencies": {
    "@eslint-community/eslint-plugin-eslint-comments": "4.8.1",
    "@harness/eslint-plugin-harness": "workspace:^",
    "@harness/schemas": "workspace:^",
    "@types/node": "22.20.5",
    "@vitest/coverage-v8": "3.2.6",
    "@vitest/eslint-plugin": "1.6.27",
    "eslint": "9.39.2",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-import-x": "4.17.1",
    "eslint-plugin-jsdoc": "60.1.0",
    "eslint-plugin-n": "17.23.1",
    "eslint-plugin-promise": "7.3.0",
    "eslint-plugin-regexp": "2.10.0",
    "eslint-plugin-unicorn": "65.0.0",
    "prettier": "3.9.9",
    "typescript": "5.9.3",
    "typescript-eslint": "8.71.1",
    "vitest": "3.2.6"
  }
}
