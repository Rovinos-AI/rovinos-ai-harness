{
  "name": "@rovinos/store-sqlite",
  "version": "0.0.0",
  "type": "module",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=26"
  },
  "files": [
    "dist/*.js",
    "dist/*.js.map",
    "dist/*.d.ts",
    "migrations"
  ],
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsup"
  },
  "dependencies": {
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "better-sqlite3": "13.0.3",
    "yaml": "2.9.1",
    "zod": "4.6.7"
  },
  "peerDependencies": {
    "@rovinos/sdk": "*"
  },
  "peerDependenciesMeta": {
    "@rovinos/sdk": {
      "optional": true
    }
  },
  "devDependencies": {
    "@rovinos/schemas": "workspace:^",
    "@rovinos/store": "workspace:^",
    "@types/better-sqlite3": "9.6.0",
    "tsup": "9.0.0",
    "typescript": "5.9.3",
    "vitest": "3.2.6"
  }
}
