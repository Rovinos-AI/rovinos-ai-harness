[
  {
    "scenario": "text_only",
    "request": {
      "requestId": "00000000000000000000000000",
      "model": { "provider": "local-endpoint", "model": "fixture-model" },
      "messages": [{ "role": "user", "parts": [{ "type": "text", "text": "hello" }] }]
    },
    "httpResponse": {
      "status": 200,
      "body": {
        "id": "fixture-completion",
        "object": "chat.completion",
        "created": 1,
        "model": "fixture-model",
        "choices": [
          {
            "index": 0,
            "message": { "role": "assistant", "content": "answer" },
            "finish_reason": "stop"
          }
        ],
        "usage": { "prompt_tokens": 2, "completion_tokens": 3, "total_tokens": 5 }
      }
    },
    "expected": {
      "parts": [
        { "type": "text", "text": "answer" },
        {
          "type": "opaque",
          "provider": "local-endpoint",
          "blob": {
            "message": { "role": "assistant", "content": "answer" },
            "openaiCallIdByCallId": {}
          }
        }
      ],
      "usage": { "inputTokens": 2, "outputTokens": 3 },
      "finishReason": "stop"
    }
  },
  {
    "scenario": "tool_call",
    "request": {
      "requestId": "00000000000000000000000000",
      "model": { "provider": "local-endpoint", "model": "fixture-model" },
      "messages": [{ "role": "user", "parts": [{ "type": "text", "text": "hello" }] }]
    },
    "httpResponse": {
      "status": 200,
      "body": {
        "id": "fixture-completion",
        "object": "chat.completion",
        "created": 1,
        "model": "fixture-model",
        "choices": [
          {
            "index": 0,
            "message": {
              "role": "assistant",
              "content": null,
              "tool_calls": [
                {
                  "id": "call_fixture",
                  "type": "function",
                  "function": { "name": "lookup", "arguments": "{\"query\":\"x\"}" }
                }
              ]
            },
            "finish_reason": "tool_calls"
          }
        ],
        "usage": { "prompt_tokens": 2, "completion_tokens": 3, "total_tokens": 5 }
      }
    },
    "expected": {
      "parts": [
        {
          "type": "tool_call",
          "callId": "00000000000000000000000000",
          "toolId": "lookup",
          "args": { "query": "x" }
        },
        {
          "type": "opaque",
          "provider": "local-endpoint",
          "blob": {
            "message": {
              "role": "assistant",
              "content": null,
              "tool_calls": [
                {
                  "id": "call_fixture",
                  "type": "function",
                  "function": { "name": "lookup", "arguments": "{\"query\":\"x\"}" }
                }
              ]
            },
            "openaiCallIdByCallId": {
              "00000000000000000000000000": "call_fixture"
            }
          }
        }
      ],
      "usage": { "inputTokens": 2, "outputTokens": 3 },
      "finishReason": "tool_calls"
    }
  },
