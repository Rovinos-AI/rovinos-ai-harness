{
  "name": "@rovinos/extension-retrieval",
  "version": "0.2.0",
  "type": "module",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Rovinos-AI/rovinos-ai-harness.git",
    "directory": "packages/extension-retrieval"
  },
  "engines": {
    "node": ">=26"
  },
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsup src/index.ts --format esm --target node26 --sourcemap --clean --external @rovinos/sdk --external @rovinos/extensions --external zod --dts --tsconfig tsconfig.json"
  },
  "peerDependencies": {
    "@rovinos/extensions": "workspace:^",
    "@rovinos/sdk": "workspace:^"
  },
  "dependencies": {
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@rovinos/extensions": "workspace:^",
    "@rovinos/sdk": "workspace:^",
    "@types/node": "26.6.6",
    "tsup": "9.0.0",
    "typescript": "5.9.3",
    "vitest": "4.1.12"
  }
}
