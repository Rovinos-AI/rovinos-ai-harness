{
  "extends": "../tsconfig.build.json",
  "compilerOptions": {
    "rootDir": "..",
    "outDir": "../dist",
    "tsBuildInfoFile": "../dist/runner.tsbuildinfo",
    "composite": true
  },
  "include": [
    "src/**/*.ts",
    "../src/inprocess.ts",
    "../src/types.ts",
    "../src/workspace.ts",
    "../src/snapshot-archive.ts",
    "../src/snapshot-restore.ts",
    "../src/web-fetch-contracts.ts"
  ],
  "exclude": ["src/**/*.test.ts"],
  "references": [
    { "path": "../../context/tsconfig.build.json" },
    { "path": "../../schemas/tsconfig.build.json" }
  ]
}
