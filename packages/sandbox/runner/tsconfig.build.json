{
  "extends": "../tsconfig.build.json",
  "compilerOptions": {
    "rootDir": "..",
    "outDir": "../dist",
    "tsBuildInfoFile": "../dist/runner.tsbuildinfo",
    "composite": true
  },
  "include": [
    "src/**/*.ts",
    "../src/inprocess.ts",
    "../src/fs-tools.ts",
    "../src/types.ts",
    "../src/workspace.ts",
    "../src/workspace-file-helpers.ts",
    "../src/workspace-files.ts",
    "../src/web-fetch-contracts.ts"
  ],
  "exclude": ["src/**/*.test.ts"],
  "references": [
    { "path": "../../context/tsconfig.build.json" },
    { "path": "../../schemas/tsconfig.build.json" }
  ]
}
